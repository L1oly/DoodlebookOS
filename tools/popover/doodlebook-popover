def waybar_status(target: str) -> int:
    state = read_state()
    unread = int(state.get("unread", 0) or 0)
    dnd = bool(state.get("dnd", False))

    if target in ("notifications", "notification", "nc"):
        if unread > 0:
            text = str(unread) if unread < 100 else "99+"
            alt = "notification"
            tooltip = f"{unread} unread notification" + ("" if unread == 1 else "s")
        elif dnd:
            text = ""
            alt = "dnd-none"
            tooltip = "Do Not Disturb"
        else:
            text = ""
            alt = "none"
            tooltip = "No notifications"
        print(json.dumps({"text": text, "alt": alt, "tooltip": tooltip, "class": alt}))
        return 0

    if target in ("quicksettings", "quick-settings", "qs"):
        print(json.dumps({"text": "", "alt": "none", "tooltip": "Quick Settings",
                          "class": "none"}))
        return 0

    print(json.dumps(state))
    return 0


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in ("daemon", "run"):
        return run_daemon()

    command = args[0].lower()

    if command == "status":
        return waybar_status(args[1].lower() if len(args) > 1 else "all")

    if command in ("toggle", "show", "hide"):
        target = args[1].lower() if len(args) > 1 else ""
        send_command(f"{command} {target}".strip())
        return 0

    if command == "hideall":
        send_command("hide")
        return 0

    if command == "quit":
        send_command("quit", autostart=False)
        return 0

    if command in ("ping", "version"):
        if command == "version":
            print("0.1.0")
            return 0
        print(send_command("ping", autostart=False) or "not-running")
        return 0

    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main())
