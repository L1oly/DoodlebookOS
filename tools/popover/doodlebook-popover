_CSS_COLOR_RE = re.compile(
    r"@define-color\s+([A-Za-z0-9_]+)\s+(#[0-9A-Fa-f]{3,8})\b"
)
_REPO_TOKEN_RE = re.compile(
    r"^#\s*([A-Za-z0-9 /]+?)\s*:\s*(#[0-9A-Fa-f]{6})\b", re.MULTILINE
)


def _read_text(path: str) -> str:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as handle:
            return handle.read()
    except OSError:
        return ""


def _parse_css_tokens(path: str) -> dict:
    return {name: value for name, value in _CSS_COLOR_RE.findall(_read_text(path))}


def _rgb_to_hex(value: str) -> str:
    parts = [part.strip() for part in value.split(",")]
    if len(parts) < 3:
        return ""
    try:
        red, green, blue = (max(0, min(255, int(part))) for part in parts[:3])
    except ValueError:
        return ""
    return f"#{red:02x}{green:02x}{blue:02x}"


def _parse_kde_tokens(path: str) -> dict:
    """Read a KDE *.colors file and expose it using MD3 token names."""
    import configparser

    parser = configparser.RawConfigParser(strict=False)
    parser.optionxform = str
    try:
        if not parser.read(path, encoding="utf-8"):
            return {}
    except (configparser.Error, OSError):
        return {}

    def get(section: str, key: str) -> str:
        try:
            return _rgb_to_hex(parser.get(section, key))
        except (configparser.Error, ValueError):
            return ""

    def first(*values: str) -> str:
        return next((value for value in values if value), "")

    window_bg = get("Colors:Window", "BackgroundNormal")
    window_alt = get("Colors:Window", "BackgroundAlternate")
    window_fg = get("Colors:Window", "ForegroundNormal")
    window_inactive = get("Colors:Window", "ForegroundInactive")
    view_bg = get("Colors:View", "BackgroundNormal")
    button_bg = get("Colors:Button", "BackgroundNormal")
    button_alt = get("Colors:Button", "BackgroundAlternate")
    selection_bg = get("Colors:Selection", "BackgroundNormal")
    selection_fg = get("Colors:Selection", "ForegroundNormal")
    tooltip_bg = get("Colors:Tooltip", "BackgroundNormal")

    tokens = {
        "surface": first(window_bg, view_bg),
        "surface_dim": first(window_bg, view_bg),
        "surface_container_lowest": first(window_bg, view_bg),
        "surface_container_low": first(view_bg, window_bg),
        "surface_container": first(window_alt, button_bg, window_bg),
        "surface_container_high": first(button_bg, window_alt, window_bg),
        "surface_container_highest": first(tooltip_bg, button_alt, button_bg),
        "surface_variant": first(button_alt, button_bg, window_alt),
        "on_surface": first(window_fg, selection_fg),
        "on_surface_variant": first(window_inactive, window_fg),
        "outline": first(window_inactive, window_fg),
        "outline_variant": first(window_alt, button_bg, window_inactive),
        "primary": first(selection_bg, get("Colors:Window", "DecorationFocus")),
        "on_primary": first(selection_fg, window_fg),
        "primary_container": first(selection_bg, button_bg),
        "on_primary_container": first(selection_fg, window_fg),
        "secondary": first(get("Colors:Button", "ForegroundLink"), selection_bg),
        "on_secondary": first(selection_fg, window_fg),
        "secondary_container": first(button_alt, button_bg),
        "on_secondary_container": first(window_fg, selection_fg),
        "tertiary": first(get("Colors:Button", "ForegroundNeutral"), selection_bg),
        "on_tertiary": first(selection_fg, window_fg),
        "error": first(get("Colors:Window", "ForegroundNegative"),
                       get("Colors:Button", "ForegroundNegative")),
        "on_error": first(get("Colors:Selection", "ForegroundNegative"), selection_fg),
        "error_container": first(get("Colors:Window", "ForegroundNegative"), selection_bg),
        "on_error_container": first(selection_fg, window_fg),
        "inverse_surface": first(tooltip_bg, window_fg),
        "inverse_on_surface": first(window_bg, selection_fg),
        "inverse_primary": first(selection_bg, window_fg),
    }
    return {name: value for name, value in tokens.items() if value}


def _parse_repo_tokens(path: str) -> dict:
    """Read the DoodlebookOS color scheme (semantic comments + sections)."""
    text = _read_text(path)
    if not text:
        return {}

    alias = {
        "surface": "surface",
        "surfacecontainer": "surface_container",
        "surfacecontainerlow": "surface_container_low",
        "surfacecontainerhigh": "surface_container_high",
        "surfacecontainerhighest": "surface_container_highest",
        "surfacedim": "surface_dim",
        "panelbg": "surface_dim",
        "pillbuttonbg": "surface_container_low",
        "pillbuttonicon": "on_surface_variant",
        "primary": "primary",
        "accent": "primary",
        "onprimary": "on_primary",
        "textprimary": "on_surface",
        "textsecondary": "on_surface_variant",
        "floatingmenubg": "surface_container_highest",
        "surfacevariant": "surface_variant",
        "outlinevariant": "outline_variant",
        "outline": "outline",
    }
    tokens = {}
    for raw_name, value in _REPO_TOKEN_RE.findall(text):
        for part in raw_name.split("/"):
            key = re.sub(r"[^a-z0-9]", "", part.lower())
            token = alias.get(key)
            if token:
                tokens[token] = value
                break
    if not tokens:
        tokens = _parse_kde_tokens(path)
    return tokens


def palette_candidates() -> list:
    """(path, parser) ordered from highest to lowest priority."""
    env_path = os.environ.get("DOODLEBOOK_POPOVER_PALETTE", "")
    repo = _repo_dir()
    return [
        (env_path, _parse_css_tokens),
        (os.path.expanduser("~/.config/vibepanel/colors.css"), _parse_css_tokens),
        (os.path.expanduser("~/.config/waybar/colors.css"), _parse_css_tokens),
        (os.path.expanduser("~/.config/matugen/colors.css"), _parse_css_tokens),
        (os.path.expanduser("~/.local/share/color-schemes/matugen.colors"),
         _parse_kde_tokens),
        (os.path.join(repo, "themes", "color-schemes", "DoodlebookOS_DARK.colors"),
         _parse_repo_tokens),
        (os.path.expanduser("~/.local/share/color-schemes/DoodlebookOS_DARK.colors"),
         _parse_repo_tokens),
        ("/usr/share/color-schemes/DoodlebookOS_DARK.colors", _parse_repo_tokens),
    ]


def palette_watch_paths() -> list:
    paths = []
    for path, _parser in palette_candidates():
        if not path or not os.path.exists(path):
            continue
        directory = os.path.dirname(path)
        for candidate in (path, directory):
            if candidate and candidate not in paths:
                paths.append(candidate)
    return paths


def load_palette() -> tuple:
    """Merge all available palettes; the highest-priority file wins."""
    colors = dict(DEFAULT_PALETTE)
    source = ""
    for path, parser in reversed(palette_candidates()):
        if not path or not os.path.isfile(path):
            continue
        tokens = parser(path)
        if tokens:
            colors.update(tokens)
            source = path
    return colors, source


def _qcolor(colors: dict, name: str, fallback: str):
    from PySide6.QtGui import QColor

    value = colors.get(name) or fallback
    color = QColor(str(value))
    return color if color.isValid() else QColor(fallback)


def apply_palette(app, colors: dict) -> None:
    """Apply MD3 roles to the Qt palette used by native controls and icons."""
    from PySide6.QtGui import QPalette

    def color(name: str, fallback: str):
        return _qcolor(colors, name, fallback)

    palette = QPalette()
    palette.setColor(QPalette.Window, color("surface_container", "#1d2024"))
    palette.setColor(QPalette.WindowText, color("on_surface", "#e1e2e9"))
    palette.setColor(QPalette.Base, color("surface_container_low", "#191c20"))
    palette.setColor(QPalette.AlternateBase, color("surface_container", "#1d2024"))
    palette.setColor(QPalette.ToolTipBase, color("surface_container_highest", "#32353a"))
    palette.setColor(QPalette.ToolTipText, color("on_surface", "#e1e2e9"))
    palette.setColor(QPalette.Text, color("on_surface", "#e1e2e9"))
    palette.setColor(QPalette.PlaceholderText, color("on_surface_variant", "#c3c6cf"))
    palette.setColor(QPalette.Button, color("surface_container_high", "#272a2f"))
    palette.setColor(QPalette.ButtonText, color("on_surface", "#e1e2e9"))
    palette.setColor(QPalette.BrightText, color("on_surface", "#e1e2e9"))
    palette.setColor(QPalette.Highlight, color("primary", "#a4c9fe"))
    palette.setColor(QPalette.HighlightedText, color("on_primary", "#00315c"))
    palette.setColor(QPalette.Link, color("primary", "#a4c9fe"))
    palette.setColor(QPalette.LinkVisited, color("tertiary", "#d9bde3"))

    disabled = color("on_surface_variant", "#c3c6cf")
    for role in (QPalette.WindowText, QPalette.Text, QPalette.ButtonText):
        palette.setColor(QPalette.Disabled, role, disabled)
    palette.setColor(QPalette.Disabled, QPalette.Highlight,
                     color("surface_container_high", "#272a2f"))
    palette.setColor(QPalette.Disabled, QPalette.HighlightedText, disabled)
    app.setPalette(palette)


