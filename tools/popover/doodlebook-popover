def _backlight_files():
    devices = sorted(glob.glob("/sys/class/backlight/*/brightness"))
    for path in devices:
        max_path = os.path.join(os.path.dirname(path), "max_brightness")
        try:
            with open(path, "r", encoding="ascii") as handle:
                current = int(handle.read().strip())
            with open(max_path, "r", encoding="ascii") as handle:
                maximum = int(handle.read().strip())
            return path, current, maximum
        except (OSError, ValueError):
            continue
    return None, 0, 0


# ---------------------------------------------------------------------------
# DDC/CI brightness (desktop monitors)
# ---------------------------------------------------------------------------

I2C_RDWR = 0x0707
I2C_M_RD = 0x0001
DDC_ADDRESS = 0x37


class _I2CMessage(ctypes.Structure):
    _fields_ = [
        ("addr", ctypes.c_uint16),
        ("flags", ctypes.c_uint16),
        ("length", ctypes.c_uint16),
        ("buffer", ctypes.POINTER(ctypes.c_uint8)),
    ]


class _I2CRdwrData(ctypes.Structure):
    _fields_ = [
        ("messages", ctypes.POINTER(_I2CMessage)),
        ("count", ctypes.c_uint32),
    ]


def _i2c_transfer(fd: int, payload=None, read_length: int = 0) -> bytes:
    messages = []
    buffers = []
    if payload:
        buffer = (ctypes.c_uint8 * len(payload))(*payload)
        buffers.append(buffer)
        messages.append(_I2CMessage(DDC_ADDRESS, 0, len(payload), buffer))
    if read_length:
        buffer = (ctypes.c_uint8 * read_length)()
        buffers.append(buffer)
        messages.append(_I2CMessage(DDC_ADDRESS, I2C_M_RD, read_length, buffer))
    if not messages:
        return b""
    array = (_I2CMessage * len(messages))(*messages)
    data = _I2CRdwrData(array, len(messages))
    fcntl.ioctl(fd, I2C_RDWR, data)
    return bytes(buffers[-1]) if read_length else b""


def _ddc_checksum(payload) -> int:
    value = DDC_ADDRESS << 1
    for byte in payload:
        value ^= byte
    return value & 0xff


class _DdcDisplay:
    """Minimal DDC/CI client for VCP 0x10 (luminance/brightness)."""

    def __init__(self, bus: int, fd: int):
        self.bus = bus
        self.fd = fd
        self.available = False
        self.current = 100
        self.maximum = 100
        self.refresh()

    def close(self) -> None:
        try:
            os.close(self.fd)
        except OSError:
            pass

    def _get_vcp(self, code: int):
        request = [0x51, 0x82, 0x01, code]
        request.append(_ddc_checksum(request))
        _i2c_transfer(self.fd, request)
        time.sleep(0.05)
        reply = _i2c_transfer(self.fd, read_length=11)
        if len(reply) < 11 or reply[0] != 0x6e:
            return None
        # reply: address, length, opcode, result, vcp, type, max_hi, max_lo, cur_hi, cur_lo, checksum
        if reply[2] != 0x02 or reply[3] != 0x00 or reply[4] != code:
            return None
        maximum = (reply[6] << 8) | reply[7]
        current = (reply[8] << 8) | reply[9]
        return current, maximum

    def refresh(self) -> bool:
        result = self._get_vcp(0x10)
        if not result:
            self.available = False
            return False
        current, maximum = result
        if maximum <= 0:
            self.available = False
            return False
        self.current = current
        self.maximum = maximum
        self.available = True
        return True

    def set_brightness(self, percent: int) -> bool:
        if not self.available:
            return False
        target = int(round(self.maximum * max(0, min(100, int(percent))) / 100))
        target = max(0, min(self.maximum, target))
        request = [0x51, 0x84, 0x03, 0x10, (target >> 8) & 0xff, target & 0xff]
        request.append(_ddc_checksum(request))
        _i2c_transfer(self.fd, request)
        time.sleep(0.05)
        self.current = target
        return True


def _ddc_bus_candidates():
    connected = set()
    for path in glob.glob("/sys/class/drm/card*-*"):
        try:
            with open(os.path.join(path, "status"), "r", encoding="ascii") as handle:
                if handle.read().strip() != "connected":
                    continue
        except OSError:
            continue
        # e.g. card0-DP-1 -> DP-1
        connected.add(os.path.basename(path).split("-", 1)[1])

    candidates = []
    for path in glob.glob("/sys/bus/i2c/devices/i2c-*"):
        try:
            number = int(os.path.basename(path)[4:])
        except ValueError:
            continue
        try:
            with open(os.path.join(path, "name"), "r", encoding="utf-8") as handle:
                name = handle.read().strip()
        except OSError:
            name = ""
        candidates.append((number, name))
    # Buses named after a connected DRM connector are the best candidates.
    candidates.sort(key=lambda item: (item[1] not in connected, item[0]))
    return candidates


def _find_ddc_display():
    for bus, name in _ddc_bus_candidates():
        if not name or "SMBus" in name or name.startswith("Synopsys"):
            continue
        try:
            fd = os.open(f"/dev/i2c-{bus}", os.O_RDWR)
        except OSError:
            continue
        try:
            display = _DdcDisplay(bus, fd)
        except (OSError, ValueError):
            try:
                os.close(fd)
            except OSError:
                pass
            continue
        if display.available:
            return display
        display.close()
    return None


