def _repo_dir() -> str:
    here = _script_dir()
    # tools/popover -> repo root
    return os.path.dirname(os.path.dirname(here))


def find_standalone_qml_dir() -> str:
    candidates = [
        os.environ.get("DOODLEBOOK_POPOVER_QML", ""),
        os.path.join(_script_dir(), "qml", "standalone"),
        os.path.join(_repo_dir(), "widgets", "StatusCluster", "contents", "ui", "standalone"),
        os.path.expanduser(
            "~/.local/share/plasma/plasmoids/org.doodlebookos.statuscluster/"
            "contents/ui/standalone"
        ),
        "/usr/share/plasma/plasmoids/org.doodlebookos.statuscluster/contents/ui/standalone",
    ]
    for candidate in candidates:
        if candidate and os.path.isfile(os.path.join(candidate, "QuickSettingsPopover.qml")):
            return candidate
    raise FileNotFoundError(
        "Could not find QuickSettingsPopover.qml. Install DoodlebookOS or set "
        "DOODLEBOOK_POPOVER_QML to the standalone QML directory."
    )


def find_imports_dir() -> str:
    candidates = [
        os.environ.get("DOODLEBOOK_POPOVER_IMPORTS", ""),
        os.path.join(_script_dir(), "qml", "imports"),
        os.path.expanduser("~/.local/share/doodlebookos/popover/imports"),
        "/usr/share/doodlebookos/popover/imports",
    ]
    for candidate in candidates:
        if candidate and os.path.isdir(candidate):
            return candidate
    return ""


