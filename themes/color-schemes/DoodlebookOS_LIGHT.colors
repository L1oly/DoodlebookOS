# OnPrimary: #ffffff (255,255,255) -> Selection:ForegroundNormal
# TextPrimary: #1b1b1f (27,27,31) -> ForegroundNormal
# TextSecondary: #5a5c64 (90,92,100) -> ForegroundInactive

